{
  "permissions": {
    "deny": [
      "Edit(./src/**/PublicAPI.Shipped.txt)",
      "Write(./src/**/PublicAPI.Shipped.txt)",
      "Read(./**/.env*)",
      "Read(./**/secrets.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/branch-guard.ps1\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.ps1\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
